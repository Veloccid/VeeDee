<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>VeeDee Agency – Più clienti per la tua attività locale</title>
<meta name="description" content="VeeDee Agency aiuta artigiani, ristoratori e imprese locali a trovare più clienti online con siti web, social media e strategie digitali concrete.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">

<style>
/* ============================
   RESET & BASE
   ============================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:        #0D0D0D;
  --surface:   #161616;
  --card:      #1E1E1E;
  --border:    #2A2A2A;
  --accent:    #FF4D1C;
  --accent2:   #FF8C69;
  --white:     #F5F2ED;
  --muted:     #8A8A8A;
  --radius:    12px;
  --max:       1160px;
  --font-head: 'Syne', sans-serif;
  --font-body: 'DM Sans', sans-serif;
}

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--white);
  font-family: var(--font-body);
  font-size: 17px;
  line-height: 1.65;
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }
ul { list-style: none; }

.container {
  width: 100%;
  max-width: var(--max);
  margin: 0 auto;
  padding: 0 24px;
}

/* ============================
   TYPOGRAPHY
   ============================ */
h1, h2, h3, h4 {
  font-family: var(--font-head);
  line-height: 1.15;
  font-weight: 800;
}

h1 { font-size: clamp(2.6rem, 6vw, 5rem); letter-spacing: -0.03em; }
h2 { font-size: clamp(2rem, 4vw, 3.2rem); letter-spacing: -0.025em; }
h3 { font-size: clamp(1.3rem, 2.5vw, 1.7rem); font-weight: 700; }
h4 { font-size: 1.1rem; font-weight: 700; }

.accent { color: var(--accent); }
.muted  { color: var(--muted); }
.tag {
  display: inline-block;
  font-family: var(--font-head);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  background: rgba(255,77,28,0.12);
  border: 1px solid rgba(255,77,28,0.3);
  padding: 5px 14px;
  border-radius: 999px;
  margin-bottom: 18px;
}

/* ============================
   BUTTONS
   ============================ */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 0.95rem;
  padding: 14px 30px;
  border-radius: 999px;
  border: none;
  cursor: pointer;
  transition: transform 0.18s, box-shadow 0.18s, background 0.18s;
  letter-spacing: 0.01em;
}
.btn:hover { transform: translateY(-2px); }

.btn-primary {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 8px 30px rgba(255,77,28,0.35);
}
.btn-primary:hover { background: #ff3500; box-shadow: 0 12px 40px rgba(255,77,28,0.55); }

.btn-outline {
  background: transparent;
  color: var(--white);
  border: 1.5px solid var(--border);
}
.btn-outline:hover { border-color: var(--accent); color: var(--accent); }

.btn-ghost {
  background: rgba(255,255,255,0.06);
  color: var(--white);
  border: 1px solid var(--border);
}
.btn-ghost:hover { background: rgba(255,255,255,0.1); }

/* ============================
   NAV
   ============================ */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  padding: 18px 0;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  background: rgba(13,13,13,0.85);
  border-bottom: 1px solid var(--border);
  transition: padding 0.3s;
}
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.logo {
  font-family: var(--font-head);
  font-weight: 800;
  font-size: 1.45rem;
  letter-spacing: -0.03em;
}
.logo span { color: var(--accent); }

.nav-links {
  display: flex;
  gap: 32px;
  align-items: center;
}
.nav-links a {
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--muted);
  transition: color 0.2s;
}
.nav-links a:hover { color: var(--white); }
.nav-links .btn { padding: 10px 22px; font-size: 0.85rem; }

.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  padding: 6px;
}
.hamburger span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--white);
  border-radius: 2px;
  transition: 0.3s;
}
.mobile-menu {
  display: none;
  position: fixed;
  inset: 0;
  background: var(--bg);
  z-index: 99;
  padding: 100px 24px 40px;
  flex-direction: column;
  gap: 32px;
}
.mobile-menu a {
  font-family: var(--font-head);
  font-size: 2rem;
  font-weight: 800;
  border-bottom: 1px solid var(--border);
  padding-bottom: 20px;
}
.mobile-menu.open { display: flex; }

/* ============================
   SECTIONS COMMON
   ============================ */
section { padding: 100px 0; }
.section-intro {
  max-width: 680px;
  margin: 0 auto 64px;
  text-align: center;
}
.section-intro p {
  color: var(--muted);
  font-size: 1.1rem;
  margin-top: 16px;
}

/* ============================
   HERO
   ============================ */
#hero {
  padding: 160px 0 100px;
  position: relative;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  top: -200px; right: -200px;
  width: 700px; height: 700px;
  background: radial-gradient(circle, rgba(255,77,28,0.18) 0%, transparent 70%);
  pointer-events: none;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,77,28,0.1);
  border: 1px solid rgba(255,77,28,0.25);
  border-radius: 999px;
  padding: 7px 16px;
  font-size: 0.85rem;
  color: var(--accent2);
  margin-bottom: 28px;
}
.hero-badge .dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--accent);
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.4); }
}

.hero-title { max-width: 840px; margin-bottom: 24px; }
.hero-sub {
  max-width: 560px;
  color: var(--muted);
  font-size: 1.15rem;
  margin-bottom: 42px;
  line-height: 1.7;
}
.hero-cta {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  align-items: center;
  margin-bottom: 64px;
}
.hero-social-proof {
  display: flex;
  align-items: center;
  gap: 16px;
  color: var(--muted);
  font-size: 0.9rem;
}
.avatars {
  display: flex;
}
.avatar {
  width: 34px; height: 34px;
  border-radius: 50%;
  border: 2px solid var(--bg);
  background: var(--card);
  margin-left: -10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--accent);
}
.avatar:first-child { margin-left: 0; }

.hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  margin-top: 64px;
}
.stat-item {
  background: var(--surface);
  padding: 28px 32px;
  text-align: center;
}
.stat-num {
  font-family: var(--font-head);
  font-size: 2.6rem;
  font-weight: 800;
  color: var(--accent);
  letter-spacing: -0.04em;
}
.stat-label { color: var(--muted); font-size: 0.88rem; margin-top: 4px; }

/* ============================
   CLIENTI / SETTORI
   ============================ */
#settori { padding: 60px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.settori-label {
  text-align: center;
  font-size: 0.82rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 28px;
}
.settori-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
}
.settore-chip {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 9px 20px;
  font-size: 0.9rem;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 8px;
  transition: border-color 0.2s, color 0.2s;
}
.settore-chip:hover { border-color: var(--accent); color: var(--white); }
.settore-chip .emoji { font-size: 1rem; }

/* ============================
   COME FUNZIONA
   ============================ */
#come-funziona { background: var(--surface); }
.steps {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 2px;
  background: var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}
.step {
  background: var(--card);
  padding: 40px 32px;
  position: relative;
}
.step-num {
  font-family: var(--font-head);
  font-size: 4rem;
  font-weight: 800;
  color: rgba(255,77,28,0.15);
  letter-spacing: -0.05em;
  line-height: 1;
  margin-bottom: 12px;
}
.step h4 { margin-bottom: 10px; color: var(--white); }
.step p { color: var(--muted); font-size: 0.95rem; }

/* ============================
   SERVIZI
   ============================ */
#servizi {}
.servizi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 20px;
}
.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 36px;
  position: relative;
  transition: border-color 0.2s, transform 0.2s;
}
.card:hover { border-color: var(--accent); transform: translateY(-4px); }
.card-icon {
  width: 52px; height: 52px;
  border-radius: 10px;
  background: rgba(255,77,28,0.1);
  border: 1px solid rgba(255,77,28,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  margin-bottom: 20px;
}
.card h3 { margin-bottom: 12px; }
.card p { color: var(--muted); margin-bottom: 20px; font-size: 0.95rem; }
.card-features {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.feature-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 0.9rem;
  color: var(--muted);
}
.feature-row::before {
  content: "✓";
  color: var(--accent);
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 1px;
}
.card-highlight {
  border-color: var(--accent);
  background: linear-gradient(135deg, var(--card) 0%, rgba(255,77,28,0.06) 100%);
}
.card-badge {
  position: absolute;
  top: -14px; right: 24px;
  background: var(--accent);
  color: #fff;
  font-family: var(--font-head);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 5px 14px;
  border-radius: 999px;
}

/* ============================
   PERCHÉ VEEDEE
   ============================ */
#perche { background: var(--surface); }
.perche-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}
.perche-left h2 { margin-bottom: 20px; }
.perche-left p { color: var(--muted); margin-bottom: 32px; font-size: 1.05rem; }
.perche-items { display: flex; flex-direction: column; gap: 20px; }
.perche-item {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}
.perche-dot {
  width: 42px; height: 42px;
  border-radius: 10px;
  background: rgba(255,77,28,0.1);
  border: 1px solid rgba(255,77,28,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  flex-shrink: 0;
}
.perche-item h4 { margin-bottom: 4px; }
.perche-item p { color: var(--muted); font-size: 0.92rem; }

.vs-box {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}
.vs-header {
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.vs-col {
  padding: 18px 20px;
  font-family: var(--font-head);
  font-size: 0.85rem;
  font-weight: 700;
  text-align: center;
  letter-spacing: 0.05em;
}
.vs-col.bad { background: rgba(255,255,255,0.04); color: var(--muted); }
.vs-col.good { background: var(--accent); color: #fff; }
.vs-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1px solid var(--border);
}
.vs-cell {
  padding: 14px 20px;
  font-size: 0.88rem;
  display: flex;
  align-items: center;
  gap: 8px;
}
.vs-cell.bad { color: var(--muted); }
.vs-cell.good { color: var(--white); }
.vs-cell.bad::before { content: "✗"; color: #555; }
.vs-cell.good::before { content: "✓"; color: var(--accent); }
.vs-cell.bad { border-right: 1px solid var(--border); }

/* ============================
   RISULTATI
   ============================ */
#risultati {}
.risultati-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
}
.risultato-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 32px;
  position: relative;
  overflow: hidden;
}
.risultato-card::after {
  content: "";
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--accent), var(--accent2));
}
.ris-icon { font-size: 2rem; margin-bottom: 16px; }
.ris-num {
  font-family: var(--font-head);
  font-size: 2.4rem;
  font-weight: 800;
  color: var(--accent);
  letter-spacing: -0.04em;
  margin-bottom: 4px;
}
.ris-label { color: var(--white); font-weight: 600; margin-bottom: 8px; }
.ris-desc { color: var(--muted); font-size: 0.88rem; }

/* ============================
   PORTFOLIO
   ============================ */
#portfolio { background: var(--surface); }
.portfolio-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
}
.portfolio-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  transition: border-color 0.2s, transform 0.2s;
}
.portfolio-card:hover { border-color: var(--accent); transform: translateY(-4px); }
.portfolio-thumb {
  height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3rem;
  position: relative;
  overflow: hidden;
}
.portfolio-thumb-1 { background: linear-gradient(135deg, #1a1a2e, #16213e); }
.portfolio-thumb-2 { background: linear-gradient(135deg, #1a2010, #2d3e1a); }
.portfolio-thumb-3 { background: linear-gradient(135deg, #1a0a0a, #3e1010); }
.portfolio-thumb-4 { background: linear-gradient(135deg, #0a1a2e, #0d2244); }
.portfolio-thumb-5 { background: linear-gradient(135deg, #1a120a, #3e2a0d); }
.portfolio-thumb-6 { background: linear-gradient(135deg, #0a0a1a, #1a1030); }
.portfolio-body { padding: 24px; }
.portfolio-body .settore {
  font-size: 0.78rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
  font-weight: 600;
  margin-bottom: 8px;
}
.portfolio-body h4 { margin-bottom: 8px; }
.portfolio-body p { color: var(--muted); font-size: 0.88rem; margin-bottom: 16px; }
.portfolio-tag {
  display: inline-block;
  background: rgba(255,77,28,0.1);
  border: 1px solid rgba(255,77,28,0.2);
  color: var(--accent2);
  font-size: 0.78rem;
  padding: 4px 12px;
  border-radius: 999px;
  margin: 2px;
}

/* ============================
   PREZZI
   ============================ */
#prezzi {}
.prezzi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
  align-items: start;
}
.prezzo-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 36px;
  transition: border-color 0.2s, transform 0.2s;
}
.prezzo-card:hover { border-color: var(--accent); }
.prezzo-card.featured {
  border-color: var(--accent);
  background: linear-gradient(160deg, var(--card) 0%, rgba(255,77,28,0.07) 100%);
  transform: scale(1.02);
}
.price-category {
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 12px;
  font-weight: 600;
}
.price-name { font-family: var(--font-head); font-size: 1.5rem; font-weight: 800; margin-bottom: 16px; }
.price-amount {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  margin-bottom: 6px;
}
.price-eur {
  font-family: var(--font-head);
  font-size: 3.2rem;
  font-weight: 800;
  color: var(--accent);
  letter-spacing: -0.04em;
  line-height: 1;
}
.price-period { color: var(--muted); font-size: 0.9rem; padding-bottom: 6px; }
.price-promo {
  background: rgba(255,77,28,0.12);
  border: 1px solid rgba(255,77,28,0.25);
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 0.88rem;
  color: var(--accent2);
  margin: 16px 0;
  display: flex;
  align-items: center;
  gap: 8px;
}
.divider { height: 1px; background: var(--border); margin: 24px 0; }
.price-features { display: flex; flex-direction: column; gap: 11px; margin-bottom: 28px; }
.price-feature {
  display: flex;
  gap: 10px;
  font-size: 0.92rem;
  color: var(--muted);
  align-items: flex-start;
}
.price-feature::before {
  content: "✓";
  color: var(--accent);
  font-weight: 700;
  flex-shrink: 0;
}
.price-note {
  background: rgba(255,255,255,0.04);
  border-radius: 8px;
  padding: 12px 14px;
  font-size: 0.85rem;
  color: var(--muted);
  margin-bottom: 24px;
}
.price-custom {
  text-align: center;
  padding: 28px;
}
.price-custom .price-eur { font-size: 2rem; color: var(--white); }
.price-range { color: var(--muted); font-size: 0.88rem; margin-top: 8px; }

/* ============================
   CHI SIAMO
   ============================ */
#chi-siamo { background: var(--surface); }
.chi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}
.chi-text h2 { margin-bottom: 20px; }
.chi-text p { color: var(--muted); margin-bottom: 16px; font-size: 1.02rem; }
.chi-values {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-top: 32px;
}
.value-item {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px;
}
.value-icon { font-size: 1.4rem; margin-bottom: 10px; }
.value-item h4 { font-size: 0.95rem; margin-bottom: 4px; }
.value-item p { font-size: 0.83rem; color: var(--muted); }

.team-card-big {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 40px;
  text-align: center;
}
.team-avatar-big {
  width: 100px; height: 100px;
  border-radius: 50%;
  background: rgba(255,77,28,0.15);
  border: 2px solid rgba(255,77,28,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-head);
  font-size: 2rem;
  font-weight: 800;
  color: var(--accent);
  margin: 0 auto 20px;
}
.team-card-big h3 { margin-bottom: 6px; }
.team-role { color: var(--accent); font-size: 0.88rem; font-weight: 600; margin-bottom: 16px; }
.team-bio { color: var(--muted); font-size: 0.93rem; line-height: 1.6; }

/* ============================
   FAQ
   ============================ */
#faq {}
.faq-list { max-width: 760px; margin: 0 auto; }
.faq-item {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 12px;
  overflow: hidden;
}
.faq-question {
  padding: 22px 28px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  font-family: var(--font-head);
  font-size: 1rem;
  font-weight: 700;
  transition: background 0.2s;
  background: var(--card);
}
.faq-question:hover { background: rgba(255,77,28,0.06); }
.faq-toggle {
  width: 28px; height: 28px;
  border-radius: 50%;
  background: rgba(255,77,28,0.1);
